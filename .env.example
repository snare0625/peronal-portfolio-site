# ── Site ────────────────────────────────────────────────
# Used for metadata, sitemap and OG URLs. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" adds the clouds backdrop + floating window on desktop. Off by default (plain full-bleed site).
NEXT_PUBLIC_SHOWCASE_FRAME=false

# ── Supabase (optional) ────────────────────────────────
# Leave blank and the site runs entirely on content/seed.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key name, also accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=portfolio

# ── On-demand revalidation ─────────────────────────────
# Supabase Database Webhook → POST {SITE_URL}/api/revalidate with header x-revalidate-secret
REVALIDATE_SECRET=

# ── Contact form email notifications (optional, Resend) ─
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
